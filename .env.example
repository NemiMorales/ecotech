# ===== Base de datos (MySQL de XAMPP) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecotech

# ===== Seguridad =====
MAX_INTENTOS_LOGIN=3
# Clave Fernet para cifrar salarios. Generarla UNA vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Las dos integrantes deben usar la MISMA clave (compartirla por privado, nunca en el repo).
FERNET_KEY=

# ===== APIs externas (solo HTTPS; ninguna requiere llave) =====
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
INDICADORES_API_URL=https://open.er-api.com/v6/latest
API_TIMEOUT=5
